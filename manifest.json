{
  "description": "Simple tab manager.",
  "manifest_version": 2,
  "name": "OverTab",
  "version": "3.5",
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_icon": "icon.png"
  },
  "sidebar_action": {
    "default_icon": "icon.png",
    "default_title": "OverTab",
    "default_panel": "overtab.html?sidebar=1",
    "open_at_install": false
  },
  "permissions": ["tabs", "contextualIdentities", "contextMenus", "bookmarks"]
}